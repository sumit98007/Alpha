# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Use explicit trusted reverse-proxy IPs/CIDRs in production. Never use `true`.
# TRUST_PROXY=127.0.0.1,::1

# Provider secret: backend only; never place this in the extension or website.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
PROVIDER_TIMEOUT_MS=25000
PROVIDER_MAX_ATTEMPTS=2
PROVIDER_READINESS_CACHE_MS=30000
PROVIDER_MAX_OUTPUT_TOKENS=8192

# Production authentication: uncomment only with real OIDC/JWT values.
# AUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json
# AUTH_ISSUER=https://identity.example.com/
# AUTH_AUDIENCE=alpha-api
# Comma-separated scopes every access token must grant.
# AUTH_REQUIRED_SCOPES=alpha.api
# AUTH_ALGORITHMS=RS256
# AUTH_CLOCK_TOLERANCE_SECONDS=30
# AUTH_MAX_TOKEN_AGE_SECONDS=3600
# AUTH_JWKS_CACHE_TTL_MS=300000
# AUTH_JWKS_TIMEOUT_MS=5000

# Development/private testing only. Production rejects this configuration.
GATEWAY_API_KEY=replace_with_a_development_only_key
ALLOW_LEGACY_GATEWAY_KEY=true

MAX_PROMPT_CHARACTERS=30000
MAX_ENHANCED_OUTPUT_CHARACTERS=30000
MAX_REQUEST_BODY_BYTES=262144
RATE_LIMIT_MAX=60
USER_RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
DAILY_REQUEST_QUOTA=500
TRAFFIC_MAX_ENTRIES=50000

# Required in production for distributed user/IP limits and quotas.
# TRAFFIC_REDIS_URL=rediss://replace_with_your_traffic_redis_url
# Secret-manager value (32+ characters) used to HMAC IP/account limiter identifiers.
# TRAFFIC_KEY_SECRET=replace_with_a_random_traffic_hmac_secret

CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=86400000
# Development experiment only. Production rejects semantic similarity caching so
# any changed prompt reaches the provider instead of reusing a merely similar result.
ENABLE_SEMANTIC_CACHE=false
# REDIS_URL=redis://127.0.0.1:6379

# Required in production. Comma-separated exact HTTPS or browser-extension origins.
# ALLOWED_ORIGINS=chrome-extension://replace_with_published_extension_id
