GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Generate a long random value (for example: openssl rand -hex 32).
GATEWAY_API_KEY=replace_with_a_long_random_gateway_key
HOST=127.0.0.1
PORT=3000
MAX_PROMPT_CHARACTERS=30000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CACHE_MAX_ENTRIES=500
CACHE_TTL_MS=86400000
# Disabled by default to prevent content reuse across users.
ENABLE_SEMANTIC_CACHE=false

# Required when NODE_ENV=production. Comma-separated, exact browser origins.
# Example: chrome-extension://abcdefghijklmnopabcdefghijklmnop
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Optional. Without this, Alpha uses an in-memory cache.
# REDIS_URL=redis://127.0.0.1:6379
